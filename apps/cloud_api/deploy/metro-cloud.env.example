METRO_DATA_DIR=/var/lib/metro-cloud
METRO_DATABASE_PATH=/var/lib/metro-cloud/jobs.db
METRO_RUNNER=real
METRO_MAX_AGENTS=50
METRO_JOB_TIMEOUT_SECONDS=14400
METRO_MAX_RSS_BYTES=3221225472
METRO_WORKER_POLL_SECONDS=1
METRO_MAX_QUEUE=50
METRO_MAX_ARTIFACT_BYTES=2147483648
# Optional defense in depth. SSH tunnelling remains the network boundary.
# METRO_API_TOKEN=replace-with-a-long-random-value
