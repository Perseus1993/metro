{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {"title": "Path", "type": "string"},
        "sha256": {"title": "Sha256", "type": "string"},
        "size_bytes": {"minimum": 0, "title": "Size Bytes", "type": "integer"}
      },
      "required": ["path", "sha256", "size_bytes"],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ControlEvidence": {
      "additionalProperties": false,
      "properties": {
        "control_id": {"title": "Control Id", "type": "string"},
        "role": {
          "enum": ["ladder_rung", "qualification_control"],
          "title": "Role",
          "type": "string"
        },
        "order_index": {"minimum": 0, "title": "Order Index", "type": "integer"},
        "status": {"const": "pass", "title": "Status", "type": "string"},
        "control_spec_sha256": {"title": "Control Spec Sha256", "type": "string"},
        "scene_config_sha256": {"title": "Scene Config Sha256", "type": "string"},
        "control_artifact": {"$ref": "#/$defs/ArtifactRecord"},
        "simulation_manifest": {"$ref": "#/$defs/ArtifactRecord"},
        "saturated_flow_artifact": {
          "anyOf": [{"$ref": "#/$defs/ArtifactRecord"}, {"type": "null"}],
          "default": null
        }
      },
      "required": [
        "control_id",
        "role",
        "order_index",
        "status",
        "control_spec_sha256",
        "scene_config_sha256",
        "control_artifact",
        "simulation_manifest"
      ],
      "title": "ControlEvidence",
      "type": "object"
    },
    "RuntimeCohort": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {"title": "Scene Id", "type": "string"},
        "base_scene_config_sha256": {
          "title": "Base Scene Config Sha256",
          "type": "string"
        },
        "design_sha256": {"title": "Design Sha256", "type": "string"},
        "metro_runtime_fingerprint": {
          "additionalProperties": true,
          "title": "Metro Runtime Fingerprint",
          "type": "object"
        },
        "analysis_runtime_fingerprint": {
          "additionalProperties": true,
          "title": "Analysis Runtime Fingerprint",
          "type": "object"
        },
        "cohort_sha256": {"title": "Cohort Sha256", "type": "string"}
      },
      "required": [
        "scene_id",
        "base_scene_config_sha256",
        "design_sha256",
        "metro_runtime_fingerprint",
        "analysis_runtime_fingerprint",
        "cohort_sha256"
      ],
      "title": "RuntimeCohort",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "alignment_ladder_manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "ladder_id": {"title": "Ladder Id", "type": "string"},
    "run_id": {"title": "Run Id", "type": "string"},
    "scene_id": {"title": "Scene Id", "type": "string"},
    "profile_id": {"title": "Profile Id", "type": "string"},
    "profile_sha256": {"title": "Profile Sha256", "type": "string"},
    "runtime_cohort": {"$ref": "#/$defs/RuntimeCohort"},
    "controls": {
      "items": {"$ref": "#/$defs/ControlEvidence"},
      "title": "Controls",
      "type": "array"
    },
    "publication_control_id": {"title": "Publication Control Id", "type": "string"},
    "runner_provenance": {
      "additionalProperties": true,
      "title": "Runner Provenance",
      "type": "object"
    },
    "step5_implementation_gate": {
      "const": "pass",
      "title": "Step5 Implementation Gate",
      "type": "string"
    },
    "release_eligible": {
      "const": false,
      "default": false,
      "title": "Release Eligible",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "ladder_id",
    "run_id",
    "scene_id",
    "profile_id",
    "profile_sha256",
    "runtime_cohort",
    "controls",
    "publication_control_id",
    "runner_provenance",
    "step5_implementation_gate"
  ],
  "title": "LadderManifest",
  "type": "object"
}
